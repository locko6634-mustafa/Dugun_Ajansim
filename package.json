{
  "name": "dugun-ajansim-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dugun Ajansim frontend kalite ve regresyon testleri",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "node tools/build-home-css.mjs",
    "format": "prettier --write \"**/*.{html,css,js,json,md,mjs}\"",
    "format:check": "prettier --check package.json \"*.config.js\" \"tests/**/*.js\" \"tools/**/*.mjs\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "validate:html": "html-validate \"*.html\"",
    "validate": "npm run format:check && npm run lint:js && npm run lint:css && npm run validate:html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run validate && npm run test:e2e",
    "audit:performance": "node tools/check-performance-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.35.0",
    "html-validate": "^11.5.6",
    "prettier": "^3.6.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
