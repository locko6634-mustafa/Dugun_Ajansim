{
  "name": "dugun-ajansim-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dugun Ajansim frontend kalite ve regresyon testleri",
  "scripts": {
    "build": "npm run build:site-content && npm run build:css",
    "build:site-content": "node tools/sync-site-content.mjs",
    "build:css": "node tools/build-home-css.mjs",
    "optimize:images": "node tools/optimize-images.mjs",
    "format": "prettier --write \"**/*.{html,css,js,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md,mjs}\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "validate:html": "html-validate \"*.html\"",
    "validate:domain-contract": "node tools/check-domain-contract.mjs",
    "validate:site-content": "node tools/sync-site-content.mjs --check && node tools/check-site-content.mjs",
    "validate:asset-cache": "node tools/check-asset-cache-policy.mjs",
    "validate:asset-url": "node --test tools/asset-url.test.mjs",
    "validate:runtime-config": "node --test tools/runtime-config.test.mjs",
    "validate:html-escaping": "node --test tools/html.test.mjs",
    "validate:booking-schedule-policy": "node --test tools/booking-schedule-policy.test.mjs",
    "validate:serve-security": "node --test tools/serve.test.mjs",
    "validate:dependency-security": "node --test tools/dependency-security.test.mjs",
    "validate:operations-security": "node --test tools/operations-security.test.mjs",
    "validate:backup-safety": "node --test deploy/tests/backup-pruning.test.mjs",
    "validate:file-secrets": "node --test deploy/tests/postgres-file-secrets.test.mjs && node --test deploy/tests/production-secret-sources.test.mjs && node --test deploy/tests/backup-crypto.test.mjs && node --test deploy/tests/pii-maintenance-result.test.mjs",
    "validate:deploy-health": "node --test deploy/tests/public-health-contract.test.mjs",
    "validate": "npm run format:check && npm run lint:js && npm run lint:css && npm run validate:html && npm run validate:domain-contract && npm run validate:site-content && npm run validate:asset-cache && npm run coverage:frontend && npm run validate:serve-security && npm run validate:dependency-security && npm run validate:operations-security && npm run validate:backup-safety && npm run validate:file-secrets && npm run validate:deploy-health",
    "test:targeted": "playwright test",
    "test:phase01-container": "playwright test --config=playwright.phase01.config.js",
    "test:phase06": "playwright test --config=playwright.phase06.config.js",
    "test:phase06:channels": "playwright test --config=playwright.channels.config.js",
    "test:phase06:sanitize-har": "node tools/sanitize-playwright-har.mjs",
    "coverage:frontend": "node --test --experimental-test-coverage --test-coverage-include=js/shared/asset-url.js --test-coverage-include=js/shared/booking-schedule-policy.js --test-coverage-include=js/shared/html.js --test-coverage-include=js/shared/runtime-config.js --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 tools/asset-url.test.mjs tools/booking-schedule-policy.test.mjs tools/html.test.mjs tools/runtime-config.test.mjs",
    "test:quick": "node tools/agent-check.mjs",
    "test:agent-check": "node --test tools/agent-check.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run validate && npm run test:e2e",
    "audit:dependencies": "npm audit",
    "audit:performance": "node tools/check-performance-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.35.0",
    "html-validate": "^11.5.6",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
