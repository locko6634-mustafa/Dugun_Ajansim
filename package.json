{
  "name": "dugun-ajansim-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dugun Ajansim frontend kalite ve regresyon testleri",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "node tools/build-home-css.mjs",
    "optimize:images": "node tools/optimize-images.mjs",
    "format": "prettier --write \"**/*.{html,css,js,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md,mjs}\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "validate:html": "html-validate \"*.html\"",
    "validate:domain-contract": "node tools/check-domain-contract.mjs",
    "validate:site-content": "node tools/check-site-content.mjs",
    "validate:asset-cache": "node tools/check-asset-cache-policy.mjs",
    "validate:runtime-config": "node --test tools/runtime-config.test.mjs",
    "validate:serve-security": "node --test tools/serve.test.mjs",
    "validate": "npm run format:check && npm run lint:js && npm run lint:css && npm run validate:html && npm run validate:domain-contract && npm run validate:site-content && npm run validate:asset-cache && npm run validate:runtime-config && npm run validate:serve-security",
    "test:targeted": "playwright test",
    "test:quick": "node tools/agent-check.mjs",
    "test:agent-check": "node --test tools/agent-check.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run validate && npm run test:e2e",
    "audit:performance": "node tools/check-performance-budget.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.35.0",
    "html-validate": "^11.5.6",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
