# Sunucu Ayarları
PORT=5000
NODE_ENV=development
TRUST_PROXY=0
HEALTHCHECK_TIMEOUT_MS=3000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Güvenlik & CORS (Virgül ile ayrılmış domainler)
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
BOT_PROTECTION_MODE=disabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_VERIFY_TIMEOUT_MS=5000
DELIVERY_LINK_VERIFICATION_MODE=remote

# Veritabanı Bağlantısı (PostgreSQL)
# Production ortamında en az 20 karakterlik yüksek entropili parola, sslmode=require ve sslaccept=strict kullanın.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dugun_ajansim?schema=public

# 32 baytlık rastgele anahtarın 64 karakterlik hex gösterimi.
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATA_ENCRYPTION_ACTIVE_KEY_ID=legacy
DATA_ENCRYPTION_KEYRING_JSON={"legacy":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
PII_BLIND_INDEX_KEY=f1e2d3c4b5a69788776655443322110089abcdef0123456776543210fedcba98
PII_BLIND_INDEX_ACTIVE_KEY_ID=legacy
PII_BLIND_INDEX_KEYRING_JSON={"legacy":"f1e2d3c4b5a69788776655443322110089abcdef0123456776543210fedcba98"}
RATE_LIMIT_HMAC_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
# Rolling rollback penceresinde dual; ardından encrypted; backfill doğrulamasından sonra strict.
PII_ENCRYPTION_MODE=dual
# Yalnız sentetik geliştirme/test verisi için açıkça true yapın; varsayılan gerçek PII yazımı kapalıdır.
ALLOW_NON_PRODUCTION_SYNTHETIC_PII_WRITES=false
SESSION_COOKIE_NAME=dugunajansim_session
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8
REMEMBER_SESSION_TTL_DAYS=30
ADMIN_SESSION_IDLE_MINUTES=240
SALON_SESSION_IDLE_MINUTES=60
CUSTOMER_SESSION_IDLE_HOURS=12
PUBLIC_APPLICATION_RETENTION_DAYS=90
ARCHIVED_APPLICATION_RETENTION_DAYS=365
ARCHIVED_WEDDING_RETENTION_DAYS=3650
SECURITY_ARTIFACT_RETENTION_DAYS=30
DATA_RETENTION_BATCH_SIZE=100
DATA_RETENTION_MAX_BATCHES=1000

# Ödeme talimatları. PAYMENT_MODE=live yalnızca gerçek, doğrulanmış bilgilerle kullanılmalıdır.
PAYMENT_MODE=test
PAYMENT_BANK_NAME=TEST BANKASI
PAYMENT_ACCOUNT_HOLDER=Düğün Ajansım Test Hesabı
PAYMENT_IBAN=TR000000000000000000000000
PAYMENT_WHATSAPP_PHONE=905555555555

# İlk admin yalnızca `npm run admin:bootstrap` komutuyla oluşturulur.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
