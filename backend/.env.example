# Sunucu Ayarları
PORT=5000
NODE_ENV=development
TRUST_PROXY=0
HEALTHCHECK_TIMEOUT_MS=3000

# Güvenlik & CORS (Virgül ile ayrılmış domainler)
CORS_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Veritabanı Bağlantısı (PostgreSQL)
# Production ortamında güçlü parola ve sslmode=require/verify-ca/verify-full kullanın.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dugun_ajansim?schema=public
