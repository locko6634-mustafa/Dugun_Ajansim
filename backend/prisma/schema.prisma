generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALON_YETKILISI
  MUSTERI
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BookingStatus {
  ONAY_BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  IPTAL_EDILDI
}

enum BookingSource {
  PUBLIC_FORM
  ADMIN
}

enum PrimaryContact {
  GELIN
  DAMAT
}

enum PaymentMethod {
  CASH
  DEPOSIT
}

enum DeliveryStatus {
  HAZIRLANIYOR
  MONTAJ
  KONTROL
  TESLIME_HAZIR
  TESLIM_EDILDI
}

enum MessageKind {
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  ACCOUNT_ACTIVATION
  PREPARATION_UPDATE
  DELIVERY_READY
  PASSWORD_RESET
}

enum MessageStatus {
  PLANNED
  PREPARED
  READY_TO_SEND
  SENT
  FAILED
  CANCELLED
}

enum MessageChannel {
  WHATSAPP
}

enum PasswordSetupPurpose {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum StaffSpecialty {
  PHOTOGRAPHY
  VIDEO
  DRONE
  JIMMY_JIB
  ASSISTANT
  EDITING
  ALBUM
}

model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("system_health")
}

model Venue {
  id           String               @id @default(uuid())
  slug         String               @unique
  name         String               @unique
  displayName  String?
  imagePath    String?
  displayOrder Int                  @default(0)
  isFeatured   Boolean              @default(false)
  isActive     Boolean              @default(true)
  isPartner    Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  managers     User[]
  applications BookingApplication[]
  weddings     Wedding[]
  staff        Staff[]

  @@index([isActive, name])
  @@index([isActive, isPartner, isFeatured, displayOrder])
  @@map("venues")
}

model User {
  id                         String                  @id @default(uuid())
  username                   String                  @unique
  passwordHash               String
  role                       UserRole
  status                     UserStatus              @default(ACTIVE)
  mustChangePassword         Boolean
  temporaryPasswordExpiresAt DateTime?
  activeAt                   DateTime?
  passwordChangedAt          DateTime?
  lastLoginAt                DateTime?
  totpSecretCiphertext       String?
  totpSecretIv               String?
  totpSecretAuthTag          String?
  totpKeyId                  String?
  totpEnrollmentExpiresAt    DateTime?
  totpEnabledAt              DateTime?
  totpLastUsedStep           BigInt?
  venueId                    String?
  venue                      Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  sessions                   AuthSession[]
  trustedDevices             TrustedDevice[]
  customerWedding            Wedding?                @relation("CustomerWedding")
  reviewedBookings           BookingApplication[]    @relation("BookingReviewer")
  auditLogs                  AuditLog[]
  deliveryHistory            DeliveryStatusHistory[]
  revokedDeliveries          Delivery[]              @relation("DeliveryRevokedBy")
  cancelledWeddings          Wedding[]               @relation("WeddingCancelledBy")
  reinstatedWeddings         Wedding[]               @relation("WeddingReinstatedBy")
  sentMessages               MessageTask[]           @relation("MessageSender")
  earlyOverriddenMessages    MessageTask[]           @relation("MessageEarlyOverrideBy")
  cancelledMessages          MessageTask[]           @relation("MessageCancelledBy")
  archivedApplications       BookingApplication[]    @relation("ApplicationArchivedBy")
  archivedWeddings           Wedding[]               @relation("WeddingArchivedBy")
  passwordSetupTokens        PasswordSetupToken[]    @relation("PasswordSetupTokenUser")
  issuedPasswordSetupTokens  PasswordSetupToken[]    @relation("PasswordSetupTokenIssuer")

  @@index([role, status])
  @@index([venueId])
  @@map("users")
}

model AuthSession {
  id                    String    @id @default(uuid())
  tokenHash             String    @unique
  csrfTokenHash         String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  lastUsedAt            DateTime  @default(now())
  mfaVerifiedAt         DateTime?
  adminStepUpVerifiedAt DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model TrustedDevice {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  userAgentHash String
  trusted       Boolean   @default(false)
  lastMfaAt     DateTime
  expiresAt     DateTime
  lastUsedAt    DateTime  @default(now())
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("trusted_devices")
}

model RateLimitBucket {
  keyHash   String   @id
  hits      Int
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model PasswordSetupToken {
  id          String               @id @default(uuid())
  tokenHash   String               @unique @db.Char(64)
  userId      String
  user        User                 @relation("PasswordSetupTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     PasswordSetupPurpose
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?                @relation("PasswordSetupTokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  messageTask MessageTask?
  createdAt   DateTime             @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt, revokedAt])
  @@index([createdById])
  @@map("password_setup_tokens")
}

model Package {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  subtitle     String?
  description  String?
  imagePath    String?
  priceCents   Int
  deliveryText String?
  features     String[]             @default([])
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  applications BookingApplication[]

  @@index([isActive, name])
  @@map("packages")
}

model Service {
  id          String                      @id @default(uuid())
  code        String                      @unique
  category    String
  name        String
  eyebrow     String?
  description String?
  imagePath   String?
  priceCents  Int
  delivery    String?
  features    String[]                    @default([])
  gallery     String[]                    @default([])
  isActive    Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  snapshots   BookingApplicationService[]

  @@index([isActive, category, name])
  @@map("services")
}

model BookingApplication {
  id                            String                      @id @default(uuid())
  referenceCode                 String                      @unique
  idempotencyKey                String?                     @unique
  idempotencyFingerprint        String?
  idempotencyFingerprintHmac    String?                     @db.Char(64)
  idempotencyFingerprintKeyId   String?
  idempotencyFingerprintVersion Int?
  source                        BookingSource
  status                        BookingStatus               @default(ONAY_BEKLIYOR)
  brideFirstName                String?
  brideLastName                 String?
  bridePhone                    String?
  groomFirstName                String?
  groomLastName                 String?
  groomPhone                    String?
  primaryContact                PrimaryContact
  primaryEmail                  String?
  piiCiphertext                 String?
  piiIv                         String?
  piiAuthTag                    String?
  piiKeyId                      String?
  piiEncryptionVersion          Int?
  piiSchemaVersion              Int?
  piiRevision                   Int                         @default(0)
  primaryEmailBlindIndex        String?                     @db.Char(64)
  bridePhoneBlindIndex          String?                     @db.Char(64)
  groomPhoneBlindIndex          String?                     @db.Char(64)
  piiBlindIndexKeyId            String?
  piiBlindIndexVersion          Int?
  weddingStartsAt               DateTime
  weddingEndsAt                 DateTime
  venueId                       String?
  venue                         Venue?                      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  packageId                     String
  package                       Package                     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageCodeSnapshot           String
  packageNameSnapshot           String
  packagePriceCents             Int
  totalPriceCents               Int
  paymentMethod                 PaymentMethod
  payableNowCents               Int
  paymentNotificationChannel    String?
  paymentFlowTokenHash          String?
  paymentFlowExpiresAt          DateTime?
  whatsappHandoffAt             DateTime?
  paymentFlowExpiredAt          DateTime?
  note                          String?
  privacyConsentAt              DateTime?
  marketingConsentAt            DateTime?
  reviewedAt                    DateTime?
  reviewedById                  String?
  reviewedBy                    User?                       @relation("BookingReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  rejectionReason               String?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  deletedAt                     DateTime?
  deletedById                   String?
  deletedBy                     User?                       @relation("ApplicationArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  services                      BookingApplicationService[]
  wedding                       Wedding?
  messageTasks                  MessageTask[]

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([venueId, weddingStartsAt])
  @@index([packageId])
  @@index([reviewedById])
  @@index([primaryEmail])
  @@index([deletedAt])
  @@index([status, whatsappHandoffAt, paymentFlowExpiresAt])
  @@map("booking_applications")
}

model BookingApplicationService {
  id            String             @id @default(uuid())
  applicationId String
  application   BookingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  codeSnapshot  String
  nameSnapshot  String
  priceCents    Int
  createdAt     DateTime           @default(now())

  @@unique([applicationId, serviceId])
  @@index([serviceId])
  @@map("booking_application_services")
}

model Wedding {
  id                     String              @id @default(uuid())
  applicationId          String              @unique
  application            BookingApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  customerUserId         String              @unique
  customerUser           User                @relation("CustomerWedding", fields: [customerUserId], references: [id], onDelete: Restrict)
  brideFirstName         String?
  brideLastName          String?
  bridePhone             String?
  groomFirstName         String?
  groomLastName          String?
  groomPhone             String?
  primaryContact         PrimaryContact
  primaryEmail           String?
  piiCiphertext          String?
  piiIv                  String?
  piiAuthTag             String?
  piiKeyId               String?
  piiEncryptionVersion   Int?
  piiSchemaVersion       Int?
  piiRevision            Int                 @default(0)
  primaryEmailBlindIndex String?             @db.Char(64)
  bridePhoneBlindIndex   String?             @db.Char(64)
  groomPhoneBlindIndex   String?             @db.Char(64)
  piiBlindIndexKeyId     String?
  piiBlindIndexVersion   Int?
  startsAt               DateTime
  endsAt                 DateTime
  venueId                String
  venue                  Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  packageSummary         Json
  paymentTotalCents      Int                 @default(0)
  paymentDepositCents    Int                 @default(0)
  paymentReceivedCents   Int                 @default(0)
  note                   String?
  cancelledAt            DateTime?
  cancellationReason     String?
  cancelledById          String?
  cancelledBy            User?               @relation("WeddingCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledByRole        UserRole?
  reinstatedAt           DateTime?
  reinstatedById         String?
  reinstatedBy           User?               @relation("WeddingReinstatedBy", fields: [reinstatedById], references: [id], onDelete: Restrict)
  reinstatementReason    String?
  deletedAt              DateTime?
  deletedById            String?
  deletedBy              User?               @relation("WeddingArchivedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  delivery               Delivery?
  messageTasks           MessageTask[]
  assignments            WeddingAssignment[]

  @@index([venueId, startsAt])
  @@index([startsAt, endsAt])
  @@index([startsAt, id])
  @@index([cancelledAt])
  @@index([cancelledById])
  @@index([reinstatedAt])
  @@index([reinstatedById])
  @@index([deletedAt])
  @@map("weddings")
}

model Staff {
  id                   String              @id @default(uuid())
  firstName            String?
  lastName             String?
  phone                String?
  piiCiphertext        String?
  piiIv                String?
  piiAuthTag           String?
  piiKeyId             String?
  piiEncryptionVersion Int?
  piiSchemaVersion     Int?
  piiRevision          Int                 @default(0)
  phoneBlindIndex      String?             @db.Char(64)
  piiBlindIndexKeyId   String?
  piiBlindIndexVersion Int?
  specialties          StaffSpecialty[]
  isActive             Boolean             @default(true)
  venueId              String
  venue                Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  assignments          WeddingAssignment[]

  @@index([isActive])
  @@index([venueId, isActive])
  @@map("staff")
}

model WeddingAssignment {
  id        String         @id @default(uuid())
  weddingId String
  wedding   Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  specialty StaffSpecialty
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([weddingId, staffId])
  @@index([staffId])
  @@index([weddingId, specialty])
  @@map("wedding_assignments")
}

model Delivery {
  id                 String                  @id @default(uuid())
  weddingId          String                  @unique
  wedding            Wedding                 @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  status             DeliveryStatus          @default(HAZIRLANIYOR)
  dueDate            DateTime                @db.Date
  driveUrlCiphertext String?
  driveUrlIv         String?
  driveUrlAuthTag    String?
  driveUrlKeyId      String?
  encryptionVersion  Int                     @default(2)
  releasedAt         DateTime?
  accessExpiresAt    DateTime?
  revokedAt          DateTime?
  revokedById        String?
  revokedBy          User?                   @relation("DeliveryRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revocationReason   String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  history            DeliveryStatusHistory[]

  @@index([status, dueDate])
  @@index([revokedById])
  @@map("deliveries")
}

model DeliveryStatusHistory {
  id          String          @id @default(uuid())
  deliveryId  String
  delivery    Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromStatus  DeliveryStatus?
  toStatus    DeliveryStatus
  actorUserId String?
  actor       User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime        @default(now())

  @@index([deliveryId, createdAt])
  @@index([actorUserId])
  @@map("delivery_status_history")
}

model MessageTask {
  id                        String              @id @default(uuid())
  weddingId                 String?
  wedding                   Wedding?            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  applicationId             String?
  application               BookingApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind                      MessageKind
  channel                   MessageChannel      @default(WHATSAPP)
  status                    MessageStatus       @default(PLANNED)
  dueAt                     DateTime
  recipientPhone            String?
  piiCiphertext             String?
  piiIv                     String?
  piiAuthTag                String?
  piiKeyId                  String?
  piiEncryptionVersion      Int?
  piiSchemaVersion          Int?
  piiRevision               Int                 @default(0)
  recipientPhoneBlindIndex  String?             @db.Char(64)
  piiBlindIndexKeyId        String?
  piiBlindIndexVersion      Int?
  secretCiphertext          String?
  secretIv                  String?
  secretAuthTag             String?
  encryptionVersion         Int                 @default(2)
  preparedAt                DateTime?
  preparedMessageCiphertext String?
  preparedMessageIv         String?
  preparedMessageAuthTag    String?
  readyAt                   DateTime?
  failedAt                  DateTime?
  failureReason             String?
  nextAttemptAt             DateTime?
  attemptCount              Int                 @default(0)
  lastAttemptAt             DateTime?
  earlyOverrideAt           DateTime?
  earlyOverrideReason       String?
  earlyOverrideById         String?
  earlyOverrideBy           User?               @relation("MessageEarlyOverrideBy", fields: [earlyOverrideById], references: [id], onDelete: SetNull)
  cancelledAt               DateTime?
  cancelledReason           String?
  cancelledById             String?
  cancelledBy               User?               @relation("MessageCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  preparedTokenId           String?             @unique
  preparedToken             PasswordSetupToken? @relation(fields: [preparedTokenId], references: [id], onDelete: SetNull)
  sentAt                    DateTime?
  sentById                  String?
  sentBy                    User?               @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@unique([weddingId, kind])
  @@unique([applicationId, kind])
  @@index([applicationId])
  @@index([earlyOverrideById])
  @@index([cancelledById])
  @@index([status, dueAt])
  @@index([dueAt, id])
  @@index([sentById])
  @@map("message_tasks")
}

model AuditLog {
  id            String       @id @default(uuid())
  actorUserId   String?
  actor         User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  targetType    String
  targetId      String?
  outcome       AuditOutcome @default(SUCCESS)
  correlationId String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
