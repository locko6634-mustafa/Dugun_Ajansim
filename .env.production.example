# DNS kaydı bu sunucunun genel IP adresine yönlenmelidir.
APP_DOMAIN=dugun.n8n-mustafa.me

# Herkese açık başvuru formu için Cloudflare Turnstile anahtarları.
BOT_PROTECTION_MODE=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TIMEOUT_MS=5000

POSTGRES_DB=dugun_ajansim
POSTGRES_USER=dugun_app
# Yalnız migration/yedekleme için kullanılan veritabanı sahibi parolası.
# En az 20 karakter; büyük/küçük harf ve rakam içeren URL-güvenli benzersiz değer kullanın.
POSTGRES_PASSWORD=

# Backend/seed/bootstrap yalnız bu DDL yetkisiz runtime rolüyle bağlanır.
POSTGRES_RUNTIME_USER=dugun_runtime
# POSTGRES_PASSWORD değerinden farklı, aynı güçte ve URL-güvenli benzersiz bir parola kullanın.
POSTGRES_RUNTIME_PASSWORD=
# Runtime sorgularının host kaynaklarını süresiz tüketmesini engelleyen rol bazlı sınırlar.
POSTGRES_RUNTIME_STATEMENT_TIMEOUT_MS=30000
POSTGRES_RUNTIME_LOCK_TIMEOUT_MS=5000
POSTGRES_RUNTIME_IDLE_TRANSACTION_TIMEOUT_MS=30000

# `openssl rand -hex 32` ile üretilecek 64 karakterlik benzersiz hex anahtar.
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY, keyring, blind-index ve rate-limit anahtarlarının SHA-256
# özetlerini virgülle listeleyin; ham anahtarları burada tekrar etmeyin.
APPLICATION_DATA_ENCRYPTION_KEY_FINGERPRINTS=
# PII için DATA_ENCRYPTION_KEY'den ayrı bir keyring ve blind-index anahtarı kullanın.
DATA_ENCRYPTION_ACTIVE_KEY_ID=pii-2026-08
DATA_ENCRYPTION_KEYRING_JSON=
PII_BLIND_INDEX_KEY=
RATE_LIMIT_HMAC_KEY=
# Production API plaintext fallback yapmaz; deploy bakımı eski kayıtları önceden dönüştürür.
PII_ENCRYPTION_MODE=strict
PII_MAINTENANCE_BATCH_SIZE=100
PII_MAINTENANCE_MAX_BATCHES=1000
# Başarısız lead, arşiv ve güvenlik artefaktı sürelerini kurum politikasına göre doğrulayın.
PUBLIC_APPLICATION_RETENTION_DAYS=90
ARCHIVED_APPLICATION_RETENTION_DAYS=365
ARCHIVED_WEDDING_RETENTION_DAYS=3650
SECURITY_ARTIFACT_RETENTION_DAYS=30
DATA_RETENTION_BATCH_SIZE=100
DATA_RETENTION_MAX_BATCHES=1000
# DATA_ENCRYPTION_KEY değerinden farklı, ayrıca üretilmiş 64 karakterlik yedek anahtarı.
BACKUP_ENCRYPTION_KEY=

# Traefik container'ının edge_proxy ağındaki sabit IP adresi; sayısal hop değeri kullanmayın.
TRUST_PROXY=

# API giriş katmanı koruması. Normal trafik ölçümleriyle kontrollü biçimde ayarlayın.
EDGE_RATE_LIMIT_AVERAGE=20
EDGE_RATE_LIMIT_PERIOD=1s
EDGE_RATE_LIMIT_BURST=40
EDGE_RATE_LIMIT_IPV6_SUBNET=56
EDGE_INFLIGHT_REQUESTS=50

# Slowloris ve uzun açık bağlantılara karşı Node HTTP sınırları (milisaniye).
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Kalıcı servis kaynak kotaları; host kapasitesine göre kontrollü biçimde ayarlayın.
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_MEMORY_RESERVATION=512m
BACKEND_CPU_LIMIT=1.50
BACKEND_MEMORY_LIMIT=768m
BACKEND_MEMORY_RESERVATION=256m
FRONTEND_CPU_LIMIT=0.75
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_MEMORY_RESERVATION=64m

SESSION_COOKIE_NAME=dugunajansim_session
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8
REMEMBER_SESSION_TTL_DAYS=30
ADMIN_SESSION_IDLE_MINUTES=30
SALON_SESSION_IDLE_MINUTES=60
CUSTOMER_SESSION_IDLE_HOURS=12
TEMPORARY_PASSWORD_TTL_HOURS=72

# Canlı ödeme bilgileri; PAYMENT_MODE yalnızca test veya live olabilir.
PAYMENT_MODE=live
PAYMENT_HANDOFF_TTL_MINUTES=60
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_IBAN=
PAYMENT_WHATSAPP_PHONE=
