# DNS kaydı bu sunucunun genel IP adresine yönlenmelidir.
APP_DOMAIN=dugun.n8n-mustafa.me

POSTGRES_DB=dugun_ajansim
POSTGRES_USER=dugun_app
# Yalnız migration/yedekleme için kullanılan veritabanı sahibi parolası.
# En az 20 karakter; büyük/küçük harf ve rakam içeren URL-güvenli benzersiz değer kullanın.
POSTGRES_PASSWORD=

# Backend/seed/bootstrap yalnız bu DDL yetkisiz runtime rolüyle bağlanır.
POSTGRES_RUNTIME_USER=dugun_runtime
# POSTGRES_PASSWORD değerinden farklı, aynı güçte ve URL-güvenli benzersiz bir parola kullanın.
POSTGRES_RUNTIME_PASSWORD=

# `openssl rand -hex 32` ile üretilecek 64 karakterlik benzersiz hex anahtar.
DATA_ENCRYPTION_KEY=

# Traefik container'ının edge_proxy ağındaki sabit IP adresi; sayısal hop değeri kullanmayın.
TRUST_PROXY=

# API giriş katmanı koruması. Normal trafik ölçümleriyle kontrollü biçimde ayarlayın.
EDGE_RATE_LIMIT_AVERAGE=20
EDGE_RATE_LIMIT_PERIOD=1s
EDGE_RATE_LIMIT_BURST=40
EDGE_RATE_LIMIT_IPV6_SUBNET=56
EDGE_INFLIGHT_REQUESTS=50

SESSION_COOKIE_NAME=dugunajansim_session
SESSION_TTL_HOURS=12
REMEMBER_SESSION_TTL_DAYS=30
ADMIN_SESSION_IDLE_MINUTES=720
SALON_SESSION_IDLE_MINUTES=720
CUSTOMER_SESSION_IDLE_HOURS=12
TEMPORARY_PASSWORD_TTL_HOURS=72

# Canlı ödeme bilgileri; PAYMENT_MODE yalnızca test veya live olabilir.
PAYMENT_MODE=live
PAYMENT_HANDOFF_TTL_MINUTES=60
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_IBAN=
PAYMENT_WHATSAPP_PHONE=
